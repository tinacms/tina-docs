{
  "name": "tina-docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-pagefind.js",
    "dev": "tinacms dev -c \"next dev --turbopack\"",
    "prebuild": "node scripts/check-build-env.js",
    "build": "echo 'Starting TinaCMS build...' && tinacms build && echo 'TinaCMS build completed. Starting Next.js build...' && next build",
    "build-local": "tinacms build --content=local --skip-cloud-checks -c \"next build\" && npx pagefind --site .next --glob \"server/**/*.html\" --output-path .next/static/pagefind && next-sitemap",
    "postbuild": "npx pagefind --site .next --glob \"server/**/*.html\" --output-path .next/static/pagefind && next-sitemap",
    "deploy": "opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare deploy",
    "upload:cf": "opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare upload",
    "preview:cf": "opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare preview",
    "build-local-pagefind": "tinacms build && next build && npx pagefind --site .next --output-subdir ../public/pagefind",
    "export": "tinacms build && EXPORT_MODE=static UNOPTIMIZED_IMAGES=true next build",
    "start": "tinacms build && next start",
    "lint": "biome check src/ tina/",
    "lint:fix": "biome check src/ tina/ --fix",
    "cleanup": "node scripts/cleanup.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-tabs": "^1.1.12",
    "copy-to-clipboard": "^3.3.3",
    "date-fns": "^4.1.0",
    "fast-glob": "^3.3.3",
    "html-to-md": "^0.8.8",
    "lodash": "^4.17.21",
    "mermaid": "^11.6.0",
    "monaco-editor": "^0.52.2",
    "motion": "^12.15.0",
    "negotiator": "^1.1.0",
    "next": "^15.5.28",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.3",
    "react-animate-height": "^3.2.3",
    "react-dom": "^19.2.3",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.1",
    "shiki": "^3.6.0",
    "tinacms": "^3.15.0",
    "title-case": "^4.3.2",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@opennextjs/cloudflare": "^1.20.14",
    "@playwright/test": "^1.54.2",
    "@shikijs/transformers": "^3.6.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@tinacms/cli": "^4.0.4",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^24.2.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "next-sitemap": "^4.2.3",
    "pagefind": "^1.3.0",
    "postcss": "^8.5.4",
    "postcss-preset-env": "^10.2.0",
    "tailwindcss": "^4.1.8",
    "worker-loader": "^3.0.8",
    "wrangler": "^4.155.0"
  },
  "cloudflare": {
    "bindings": {
      "NEXT_PUBLIC_TINA_CLIENT_ID": {
        "description": "Client ID from your project at [app.tina.io](https://app.tina.io). `tinacms build` needs it at **build** time, so also add it as a Workers Builds build variable."
      },
      "TINA_TOKEN": {
        "description": "Read-only token from [app.tina.io](https://app.tina.io). Also add it as a Workers Builds **build** variable."
      }
    }
  },
  "pnpm": {
    "overrides": {
      "@aws-sdk/checksums": "3.1002.0",
      "@aws-sdk/core": "3.979.0",
      "@aws-sdk/credential-provider-env": "3.972.79",
      "@aws-sdk/credential-provider-http": "3.972.81",
      "@aws-sdk/credential-provider-ini": "3.973.24",
      "@aws-sdk/credential-provider-login": "3.972.86",
      "@aws-sdk/credential-provider-node": "3.972.91",
      "@aws-sdk/credential-provider-process": "3.972.79",
      "@aws-sdk/credential-provider-sso": "3.973.23",
      "@aws-sdk/credential-provider-web-identity": "3.972.85",
      "@aws-sdk/dynamodb-codec": "3.973.53",
      "@aws-sdk/middleware-bucket-endpoint": "3.972.57",
      "@aws-sdk/middleware-endpoint-discovery": "3.972.36",
      "@aws-sdk/middleware-expect-continue": "3.972.53",
      "@aws-sdk/middleware-flexible-checksums": "3.974.63",
      "@aws-sdk/middleware-host-header": "3.972.54",
      "@aws-sdk/middleware-location-constraint": "3.972.50",
      "@aws-sdk/middleware-logger": "3.972.53",
      "@aws-sdk/middleware-recursion-detection": "3.972.55",
      "@aws-sdk/middleware-sdk-s3": "3.972.84",
      "@aws-sdk/middleware-sdk-sqs": "3.972.47",
      "@aws-sdk/middleware-ssec": "3.972.50",
      "@aws-sdk/middleware-user-agent": "3.972.83",
      "@aws-sdk/nested-clients": "3.997.53",
      "@aws-sdk/region-config-resolver": "3.972.57",
      "@aws-sdk/signature-v4-multi-region": "3.996.50",
      "@aws-sdk/token-providers": "3.1160.0",
      "@aws-sdk/util-user-agent-browser": "3.972.54",
      "@aws-sdk/util-user-agent-node": "3.973.69",
      "@smithy/core": "3.38.0",
      "@smithy/node-http-handler": "4.14.0"
    }
  }
}
